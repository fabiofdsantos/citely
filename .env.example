# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
CITELY_LLM_PROVIDER=anthropic          # anthropic | openai
CITELY_EMBEDDING_PROVIDER=openai       # openai (Anthropic ships no embeddings API)

# ---------------------------------------------------------------------------
# Credentials (only the ones for your selected providers are required)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
CITELY_VECTOR_STORE=chroma             # chroma | pgvector
CITELY_CHROMA_PATH=./data/chroma
# CITELY_PGVECTOR_DSN=postgresql://citely:citely@localhost:5432/citely

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
CITELY_LOG_LEVEL=INFO
CITELY_LOG_FORMAT=json                 # json | console
