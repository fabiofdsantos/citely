# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Providers
#   llm_provider:       anthropic | openai
#   embedding_provider: openai   (Anthropic ships no embeddings API)
# Leave the model vars unset to take the per-provider default.
# ---------------------------------------------------------------------------
CITELY_LLM_PROVIDER=anthropic
CITELY_EMBEDDING_PROVIDER=openai
# CITELY_LLM_MODEL=claude-sonnet-5
# CITELY_EMBEDDING_MODEL=text-embedding-3-small

# Credentials: only the ones your selected providers need.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Point at any server speaking the OpenAI wire format (Azure, gateway, proxy).
# CITELY_OPENAI_BASE_URL=

CITELY_REQUEST_TIMEOUT_SECONDS=60
CITELY_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
CITELY_VECTOR_STORE=chroma
CITELY_COLLECTION_NAME=citely
CITELY_CHROMA_PATH=./data/chroma
# CITELY_PGVECTOR_DSN=postgresql://citely:citely@localhost:5432/citely

# ---------------------------------------------------------------------------
# Ingestion and retrieval
# ---------------------------------------------------------------------------
CITELY_CORPUS_PATH=./data/corpus
CITELY_CHUNK_SIZE=1000
CITELY_CHUNK_OVERLAP=150
CITELY_TOP_K=6
CITELY_MIN_SCORE=0.0
CITELY_MAX_CONTEXT_TOKENS=6000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
CITELY_LOG_LEVEL=INFO
CITELY_LOG_FORMAT=json
